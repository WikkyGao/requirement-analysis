{
  "name": "requirement-analysis",
  "displayName": "需求分析技能",
  "version": "1.3.0",
  "description": "多格式需求文档分析与整合，生成 PRD、系统概要说明书、详细说明书、数据库设计说明书",
  "description_en": "Multi-format requirement analysis generating PRD, system overview, detailed design, and database design documents",
  "author": "wikky",
  "license": "MIT",
  "type": "module",
  "private": true,
  "keywords": [
    "atomcode",
    "skill",
    "requirement-analysis",
    "prd",
    "system-overview",
    "detailed-design",
    "database-design",
    "product-management"
  ],
  "engines": {
    "atomcode": ">=1.0.0"
  },
  "scripts": {
    "package": "bash package.sh",
    "test": "echo \"No npm tests; see python-docx/openpyxl for optional dependencies\" && exit 0"
  },
  "dependencies": {},
  "optionalDependencies": {
    "xmind": "备选：XMind 思维导图解析（当前使用 XML 解析方式）"
  },
  "atomcode": {
    "skill": true,
    "main": "SKILL.md",
    "triggers": [
      "需求分析",
      "分析需求",
      "整理需求",
      "PRD",
      "需求文档",
      "需求梳理",
      "梳理需求",
      "系统概要说明书",
      "详细说明书",
      "数据库设计说明书"
    ],
    "formats": [
      ".md",
      ".docx",
      ".xlsx",
      ".xmind",
      ".mm",
      ".mmap"
    ],
    "docTypes": [
      "prd",
      "system-overview",
      "detailed-design",
      "database-design"
    ]
  }
}
