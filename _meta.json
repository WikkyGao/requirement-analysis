{
  "name": "requirement-analysis",
  "display_name": "需求分析技能",
  "version": "1.3.0",
  "description": "多格式需求文档分析与整合。自动解析 Markdown、Excel、Word、思维导图文件，智能去重和补充需求信息，生成 PRD、系统概要说明书、详细说明书、数据库设计说明书等标准化交付文档。",
  "description_en": "Multi-format requirement document analysis and integration. Automatically parse Markdown, Excel, Word, and mind map files, intelligently deduplicate and supplement requirements, and generate standardized PRD, system overview, detailed design, and database design documents.",
  "author": {
    "name": "wikky",
    "email": "",
    "url": ""
  },
  "license": "MIT",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "tags": [
    "requirement-analysis",
    "prd",
    "product-management",
    "文档分析",
    "需求分析",
    "产品需求文档",
    "系统概要说明书",
    "详细说明书",
    "数据库设计说明书"
  ],
  "triggers": [
    "需求分析",
    "分析需求",
    "整理需求",
    "PRD",
    "需求文档",
    "需求梳理",
    "梳理需求",
    "系统概要说明书",
    "详细说明书",
    "数据库设计说明书"
  ],
  "platform": "atomcode",
  "min_agent_version": "1.0.0",
  "work_modes": [
    "standard",
    "quick",
    "incremental"
  ],
  "supported_formats": [
    {
      "format": "Markdown",
      "extensions": [
        ".md",
        ".markdown"
      ],
      "priority": 1
    },
    {
      "format": "Word",
      "extensions": [
        ".docx"
      ],
      "priority": 2
    },
    {
      "format": "Excel",
      "extensions": [
        ".xlsx",
        ".xls"
      ],
      "priority": 3
    },
    {
      "format": "MindMap",
      "extensions": [
        ".xmind",
        ".mm",
        ".mmap"
      ],
      "priority": 4
    },
    {
      "format": "NaturalLanguage",
      "priority": 0
    }
  ],
  "output": {
    "default": "PRD.md",
    "format": "markdown",
    "doc_types": [
      {
        "doc_type": "prd",
        "file": "PRD.md",
        "sections": [
          "需求概述",
          "功能清单",
          "附录"
        ]
      },
      {
        "doc_type": "system-overview",
        "file": "系统概要说明书.md",
        "sections": [
          "引言",
          "系统概述",
          "总体设计",
          "功能概要",
          "接口概要",
          "数据概要",
          "非功能需求",
          "约束与假设",
          "附录"
        ]
      },
      {
        "doc_type": "detailed-design",
        "file": "详细说明书.md",
        "sections": [
          "引言",
          "总体说明",
          "模块详细设计",
          "功能明细",
          "接口详细设计",
          "数据设计",
          "日志、异常与安全",
          "附录"
        ]
      },
      {
        "doc_type": "database-design",
        "file": "数据库设计说明书.md",
        "sections": [
          "引言",
          "设计概述",
          "逻辑数据模型",
          "物理表设计",
          "数据字典",
          "索引与约束设计",
          "初始化与迁移",
          "安全与权限",
          "附录"
        ]
      }
    ]
  },
  "dependencies": {
    "optional": {
      "python-docx": "Word (.docx) 解析增强",
      "openpyxl": "Excel (.xlsx) 解析增强",
      "in2csv": "备选 Excel 解析"
    }
  },
  "features": [
    "语义去重",
    "冲突检测",
    "INVEST 需求质量评估",
    "来源追溯",
    "增量更新",
    "快速模式",
    "飞书/Git/FTP/Obsidian/剪贴板多目标推送",
    "内置四类交付文档模板（PRD/概要/详细/数据库设计）",
    "按 doc_type 自动选择默认文件名"
  ],
  "changelog": [
    {
      "version": "1.3.0",
      "date": "2026-10-21",
      "changes": [
        "新增系统概要说明书、详细说明书、数据库设计说明书三类内置模板",
        "prd_generator 支持 --doc-type 与多文档生成",
        "T7 改为生成交付文档，支持多选文档类型",
        "新增 entities/interfaces/architecture 等结构化输入",
        "修复 references 中文文件名乱码，补齐模板引用"
      ]
    },
    {
      "version": "1.2.2",
      "date": "2026-09-20",
      "changes": [
        "功能项新增可选 screenshots（截图）与 related_pages（相关页面/原型图）字段",
        "PRD 模板完整版与摘要版均支持渲染「截图」「相关页面」小节",
        "prd_generator 实现截图/相关页面渲染，输入格式示例补充字段说明"
      ]
    },
    {
      "version": "1.2.0",
      "date": "2026-09-07",
      "changes": [
        "T2 新增大文件分层提取策略（骨架→逐批→合并），避免上下文溢出",
        "T5 新增 NFR 基线规则默认值，自动填平非功能坑",
        "T5 澄清改为按用户旅程分批提问",
        "T5 新增 MoSCoW 优先级锚定，聚焦核心主干",
        "T5 冲突改为冲突影响分析表可视化",
        "T1.5 新增需求/功能/方案三层甄别，防止方案绑架需求",
        "T7 支持用户指定输出子目录并基于目录结构推荐",
        "T7 支持完整版/业务摘要版两种输出模板",
        "T7 附录新增需求→功能→方案映射",
        "T8 简化为仅做简单引导，环境检查移交 pencil-designer"
      ]
    },
    {
      "version": "1.1.0",
      "date": "2026-07-27",
      "changes": [
        "初始版本",
        "支持标准/快速/增量三种模式",
        "支持 Markdown/Word/Excel/思维导图解析",
        "支持多目标 PRD 推送"
      ]
    },
    {
      "version": "1.1.0",
      "date": "2026-09-01",
      "changes": [
        "新增可选 pencil-designer 可视化原型流程（T8）",
        "新增 pencil-designer 协作约束"
      ]
    }
  ]
}
